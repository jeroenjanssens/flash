  "title": {
    "en": "Colours",
    "nl": "Kleuren"
  },
  "description": {
    "en": "Eleven colours in English. A deck to try Flash with.",
    "nl": "Elf kleuren in het Engels. Een stapel om Flash mee uit te proberen."
  },
  "cover": "media/orange.svg",
  "color": "#7c5cff",
  "language": "en-GB",
  "tags": [
    "english",
    "vocabulary",
    "demo"
  ],
  "source": {
    "author": "Jeroen Janssens",
    "license": "CC0-1.0"
  },
  "voices": [
    {
      "id": "female",
      "name": {
        "en": "Miss",
        "nl": "Juf"
      },
      "gender": "female",
      "lang": "en-US",
      "engine": "kokoro",
      "voice": "af_heart",
      "credit": "Kokoro-82M by hexgrad",
      "license": "Apache-2.0"
    },
    {
      "id": "male",
      "name": {
        "en": "Sir",
        "nl": "Meester"
      },
      "gender": "male",
      "lang": "en-US",
      "engine": "kokoro",
      "voice": "am_michael",
      "credit": "Kokoro-82M by hexgrad",
      "license": "Apache-2.0"
    }
  ],
  "fields": [
    {
      "id": "image",
      "type": "image",
      "name": {
        "en": "Picture",
        "nl": "Plaatje"
      }
    },
    {
      "id": "word",
      "type": "text",
      "lang": "en-GB",
      "speak": true,
      "name": {
        "en": "Word",
        "nl": "Woord"
      }
    },
    {
      "id": "translation",
      "type": "text",
      "lang": "nl",
      "optional": true,
      "name": {
        "en": "Dutch",
        "nl": "Nederlands"
      }
    }
  ],
  "templates": [
    {
      "id": "picture-to-word",
      "name": {
        "en": "Picture → English",
        "nl": "Plaatje → Engels"
      },
      "prompt": [
        "image"
      ],
      "answer": "word",
      "reveal": [
        "translation"
      ],
      "methods": [
        "type",
        "choose",
        "flip"
      ]
    },
    {
      "id": "dutch-to-english",
      "name": {
        "en": "Dutch → English",
        "nl": "Nederlands → Engels"
      },
      "prompt": [
        "translation"
      ],
      "answer": "word",
      "reveal": [
        "image"
      ],
      "methods": [
        "type",
        "choose",
        "flip"
      ]
    },
    {
      "id": "word-to-picture",
      "name": {
        "en": "English → picture",
        "nl": "Engels → plaatje"
      },
      "prompt": [
        "word"
      ],
      "answer": "image",
      "reveal": [
        "translation"
      ],
      "methods": [
        "choose"
      ],
      "enabled": false
    },
    {
      "id": "listen-to-picture",
      "name": {
        "en": "Listen → picture",
        "nl": "Luisteren → plaatje"
      },
      "prompt": [
        {
          "field": "word",
          "as": "audio"
        }
      ],
      "answer": "image",
      "reveal": [
        "word",
        "translation"
      ],
      "methods": [
        "choose"
      ],
      "enabled": false
    },
    {
      "id": "dictation",
      "name": {
        "en": "Listen → spell",
        "nl": "Luisteren → spellen"
      },
      "prompt": [
        {
          "field": "word",
          "as": "audio"
        }
      ],
      "answer": "word",
      "reveal": [
        "image",
        "translation"
      ],
      "methods": [
        "type"
      ],
      "enabled": false
    },
    {
      "id": "english-to-dutch",
      "name": {
        "en": "English → Dutch",
        "nl": "Engels → Nederlands"
      },
      "prompt": [
        "word"
      ],
      "answer": "translation",
      "reveal": [
        "image"
      ],
      "methods": [
        "type",
        "choose",
        "flip"
      ],
      "enabled": false
    }
  ],
